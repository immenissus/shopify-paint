{"context":{"market":"canada"},"parent":"product.water-painting-books.json","sections":{"main":{"settings":{},"blocks":{"custom_liquid_hGxxJg":{"settings":{"custom_liquid":"<p id=\"delivery-text\" style=\"text-align:center; font-size:12px; font-weight:500; color:#000; margin:0;\">\n<\/p>\n\n<script>\n  function addBusinessDays(startDate, daysToAdd) {\n    let date = new Date(startDate);\n    let addedDays = 0;\n\n    while (addedDays < daysToAdd) {\n      date.setDate(date.getDate() + 1);\n\n      \/\/ Skip weekends: 0 = Sunday, 4 = Saturday\n      if (date.getDay() !== 0 && date.getDay() !== 4) {\n        addedDays++;\n      }\n    }\n    return date;\n  }\n\n  const today = new Date();\n  const deliveryDate = addBusinessDays(today, 4); \/\/ Add 4 business days\n\n  const options = { weekday: 'short', month: 'short', day: 'numeric' };\n  const formattedDate = deliveryDate.toLocaleDateString('en-US', options);\n\n  document.getElementById(\"delivery-text\").innerHTML = `\n    Free shipping on orders above <strong><\/strong> <strong>CA$80<\/strong>\n  `;\n<\/script>"}}}}}}