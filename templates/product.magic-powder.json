unt":5,"video_player":"autoplay","enable_video_looping":false,"autoplay_videos_pause_btn":false,"play_btn_color_scheme":"accent-1","mobile_thumbnails":"hide","mobile_media_corner_radius":16,"mobile_spacing":true,"mobile_preview_media":false,"mobile_thumbnails_count":5,"mobile_pagination":"dots_overlay","hide_arrows":true,"dots_color_scheme":"inverse","trust_badge_position":"top-right","trust_badge_size":"medium","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36}},"related-products":{"type":"related-products","disabled":true,"settings":{"heading":"You may also like","heading_size":"h2","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"adapt","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","padding_top":36,"padding_bottom":24}},"bb7d2784-ae42-434b-aece-ca60bb5e9aa5":{"type":"collapsible-content","blocks":{"template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-0":{"type":"collapsible_row","settings":{"heading":"What exactly is the Magic Water Elf Kit?","icon":"none","row_content":"<p>It’s a fun and educational toy where kids can create colorful 3D sea creatures that magically form when the special solution touches water. It combines creativity, science, and hands-on play in one exciting activity.<\/p>","page":""}},"template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-1":{"type":"collapsible_row","settings":{"heading":"Is it safe for children?","icon":"none","row_content":"<p>Yes! The materials are non-toxic, kid-safe, and meet safety standards. Adult supervision is recommended, especially for younger children, to ensure proper use and maximum fun.<\/p>","page":""}},"template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-2":{"type":"collapsible_row","settings":{"heading":"What age is it suitable for?","icon":"none","row_content":"<p>Perfect for kids ages 4 and up. Younger children can still enjoy the kit with adult guidance, especially during mixing and creating.<\/p>","page":""}},"template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-3":{"type":"collapsible_row","settings":{"heading":"How long does each kit last?","icon":"none","row_content":"<p>Each kit comes with enough solution and molds to make dozens of creatures. With careful use, kids can create over 30+ designs depending on size and color combinations.<\/p>","page":""}},"collapsible_row_dGNwRU":{"type":"collapsible_row","settings":{"heading":"Can the creations be played with after they’re made?","icon":"none","row_content":"<p>Yes! Once hardened, the figures can be gently handled and even collected. Just avoid excessive squeezing or bending, as they are meant for light play and display.<\/p>","page":""}},"collapsible_row_qwX6hn":{"type":"collapsible_row","settings":{"heading":"Is it messy?","icon":"none","row_content":"<p>The activity involves water and color solution, so we recommend setting it up on a table or surface with a mat or newspaper. The included basin helps keep mess to a minimum.<\/p>","page":""}},"collapsible_row_qpQnGC":{"type":"collapsible_row","settings":{"heading":"Is it reusable?","icon":"none","row_content":"<p>he molds are reusable, and you can purchase additional solution packs to keep the fun going!<\/p>","page":""}},"collapsible_row_BGqbbF":{"type":"collapsible_row","settings":{"heading":"Is this a good gift?","icon":"none","row_content":"<p>Absolutely! It’s a unique, creative gift that keeps kids engaged, away from screens, and excited to create something with their own hands.<\/p>","page":""}}},"block_order":["template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-0","template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-1","template--19031306928423__bb7d2784-ae42-434b-aece-ca60bb5e9aa5-1687916948e5f2d585-2","template--1903130692